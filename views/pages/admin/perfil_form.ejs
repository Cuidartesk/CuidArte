<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../../partials/head'); %>
</head>
<body>

<!-- ============================================================
     EDITAR PERFIL DE ADMINISTRADOR (ADMIN)
     Portado de admin_perfil_editar.html del proyecto Django.
     ============================================================ -->

   <!-- INICIO MODIFICACION: header unificado igual al base.html de Django -->
   <%- include('../../partials/header'); %>
   <!-- FIN MODIFICACION -->

  <section class="welcome-section" style="padding: 40px 20px;">
    <div class="container">
      <h1>Editar Perfil</h1>
      <p>Actualiza la informaci&oacute;n de tu cuenta administrativa</p>
    </div>
  </section>

  <main class="container" style="padding: 36px 20px; max-width: 700px;">
    <a href="/admin/perfil" style="color: #6b7280; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 18px;">&larr; Volver al perfil</a>

    <% if (locals.error) { %>
      <div style="background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; padding: 12px 16px; border-radius: 10px; margin-bottom: 18px;"><%= error %></div>
    <% } %>

    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); padding: 26px;">
      <!-- INICIO MODIFICACION: envia PUT via method-override, igual que los demas formularios del panel -->
      <form method="POST" action="/admin/perfil?_method=PUT">
        <!-- FIN MODIFICACION -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
          <div>
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Nombre</label>
            <input type="text" name="nombre" value="<%= usuario.name %>" required style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb; box-sizing: border-box;">
          </div>
          <div>
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Apellido</label>
            <input type="text" name="apellido" value="<%= usuario.apellido || '' %>" style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb; box-sizing: border-box;">
          </div>
        </div>
        <div style="margin-top: 14px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Usuario</label>
          <input type="text" name="usuario" value="<%= usuario.usuario || '' %>" style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb; box-sizing: border-box;">
        </div>
        <div style="margin-top: 14px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Correo electr&oacute;nico</label>
          <input type="email" name="correo" value="<%= usuario.email %>" required style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb; box-sizing: border-box;">
        </div>
        <div style="margin-top: 14px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Fecha de nacimiento</label>
          <% var fn = usuario.fechaNacimiento ? new Date(usuario.fechaNacimiento) : null; %>
          <input type="date" name="fechaNacimiento" value="<%= fn ? fn.toISOString().substring(0, 10) : '' %>" style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb; box-sizing: border-box;">
        </div>

        <div style="display: flex; gap: 12px; margin-top: 22px; justify-content: flex-start;">
          <button type="submit" style="background: linear-gradient(135deg, #27BEF5, #6DD5FA); color: white; padding: 10px 22px; border: none; border-radius: 10px; font-weight: 700; font-size: 0.92rem; cursor: pointer; box-shadow: 0 4px 12px rgba(39,190,245,0.25);">Guardar cambios</button>
          <a href="/admin/perfil" style="background: #f3f4f6; color: #374151; padding: 10px 22px; border-radius: 10px; text-decoration: none; font-weight: 600; font-size: 0.92rem;">Cancelar</a>
        </div>
      </form>
    </div>
  </main>

  <style>
    input:focus { outline: none; border-color: #27BEF5; background: white; box-shadow: 0 0 0 3px rgba(39,190,245,0.15); }
    @media (max-width: 600px) { div[style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; } }
  </style>

   <%- include('../../partials/footer'); %>
</body>
</html>