<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../../partials/head'); %>
</head>
<body>

<!-- ============================================================
     FORMULARIO DE PRODUCTO (ADMIN) - sirve para CREAR y EDITAR
     Portado de admin_producto_form.html del Django.
     La variable "accion" dice si es "Crear" o "Editar".
     La imagen se convierte a Base64 con imagenes_base64.js.
     ============================================================ -->

   <!-- INICIO MODIFICACION: header unificado igual al base.html de Django -->
   <%- include('../../partials/header'); %>
   <!-- FIN MODIFICACION -->

  <section class="welcome-section" style="padding: 40px 20px;">
    <div class="container">
      <h1><%= accion %> Producto</h1>
      <p>Completa la informaci&oacute;n del producto de la tienda</p>
    </div>
  </section>

  <main class="container" style="padding: 40px 20px; max-width: 640px;">
    <a href="/admin/productos" style="color: #6b7280; text-decoration: none; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 20px;">&larr; Volver a Productos</a>

    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); padding: 32px;">
      <!-- INICIO MODIFICACION: el action cambia segun sea crear o editar -->
      <% if (accion === 'Editar') { %>
        <form id="formProducto" method="POST" action="/admin/productos/<%= producto._id %>?_method=PUT">
      <% } else { %>
        <form id="formProducto" method="POST" action="/admin/productos">
      <% } %>
      <!-- FIN MODIFICACION -->

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Nombre *</label>
          <input type="text" name="name" required value="<%= accion === 'Editar' ? producto.name : '' %>"
                 style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb;">
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Descripci&oacute;n *</label>
          <textarea name="description" rows="3" required
                    style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb;"><%= accion === 'Editar' ? producto.description : '' %></textarea>
        </div>

        <div style="display: flex; gap: 14px; margin-bottom: 18px;">
          <div style="flex: 1;">
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Precio (COP) *</label>
            <input type="number" name="price" min="0" required value="<%= accion === 'Editar' ? producto.price : '' %>"
                   style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb;">
          </div>
          <div style="flex: 1;">
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Stock *</label>
            <input type="number" name="stock" min="0" required value="<%= accion === 'Editar' ? producto.stock : 10 %>"
                   style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb;">
          </div>
        </div>

        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Categor&iacute;a</label>
          <select name="category"
                  style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; font-size: 0.95rem; background: #f9fafb;">
            <!-- INICIO MODIFICACION: las 5 categorias de Producto.CATEGORIAS de Django -->
            <% const CATS = [['biomedicos','Dispositivos Biom&eacute;dicos'],['suministros','Suministros M&eacute;dicos'],['movilidad','Movilidad y Ortopedia'],['cuidado','Cuidado Personal'],['otros','Otros']]; %>
            <% CATS.forEach(function(cat) { %>
              <option value="<%= cat[0] %>" <%= accion === 'Editar' && producto.category === cat[0] ? 'selected' : '' %>><%- cat[1] %></option>
            <% }); %>
            <!-- FIN MODIFICACION -->
          </select>
        </div>

        <!-- INICIO MODIFICACION: campo de imagen que se guarda en MongoDB como Base64 -->
        <div style="margin-bottom: 18px;">
          <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Imagen del producto</label>
          <input type="file" id="imagen" accept="image/*"
                 style="font-size: 0.9rem; color: #374151;">
          <img id="preview" src="<%= accion === 'Editar' && producto.imageData ? producto.imageData : '' %>" alt=""
               style="<%= accion === 'Editar' && producto.imageData ? 'display:block;' : 'display:none;' %> max-width: 200px; margin-top: 10px; border-radius: 10px;">
          <!-- Aqui JS coloca la imagen ya convertida a texto Base64 -->
          <input type="hidden" name="imageData" id="imageData"
                 value="<%= accion === 'Editar' ? producto.imageData : '' %>">
        </div>
        <!-- FIN MODIFICACION -->

        <!-- INICIO MODIFICACION: estado Activo/Inactivo, igual al Django -->
        <div style="margin-bottom: 18px;">
          <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
            <input type="checkbox" name="activo" <%= accion === 'Editar' ? (producto.activo !== false ? 'checked' : '') : 'checked' %>
                   style="width: 18px; height: 18px; accent-color: #27BEF5; cursor: pointer;">
            <span style="font-weight: 600; color: #374151; font-size: 0.9rem;">Producto activo (visible en la tienda)</span>
          </label>
        </div>
        <!-- FIN MODIFICACION -->

        <button type="submit" style="width: 100%; background: linear-gradient(135deg, #27BEF5, #6DD5FA); color: white; padding: 12px; border: none; border-radius: 10px; font-weight: 700; font-size: 1rem; cursor: pointer; margin-top: 10px; box-shadow: 0 4px 12px rgba(39,190,245,0.3);">Guardar Producto</button>
      </form>
    </div>
  </main>

   <%- include('../../partials/footer'); %>

   <!-- La conversion de imagen vive en este archivo aparte (misma logica para todo el sitio) -->
   <script src="/js/imagenes_base64.js"></script>
</body>
</html>
