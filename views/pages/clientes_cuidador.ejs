<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../partials/head'); %>
</head>
<body>

   <%- include('../partials/header'); %>

<!-- INICIO MODIFICACION: clientes, portado de clientes_cuidador.html de Django -->
  <main class="dashboard-content">
    <section class="welcome-section">
      <div class="container">
        <h1>Clientes</h1>
        <p>Lista de clientes registrados en la plataforma.</p>
      </div>
    </section>

    <section class="dashboard-main container">
      <% if (clientes.length > 0) { %>
        <p style="color: #6b7280; margin-bottom: 18px;"><%= clientes.length %> cliente(s) registrado(s)</p>
        <div class="clientes-list" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
          <% clientes.forEach(function(c) { %>
            <div class="cliente-card" style="background: white; border-radius: 16px; padding: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
              <div class="cliente-header" style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
                <% if (c.foto) { %>
                  <img src="<%= c.foto %>" alt="<%= c.name %> <%= c.apellido %>" class="cliente-avatar" style="width: 56px; height: 56px; border-radius: 50%; object-fit: cover;">
                <% } else { %>
                  <!-- INICIO MODIFICACION: marcador con iniciales cuando no hay foto -->
                  <div style="width: 56px; height: 56px; border-radius: 50%; background: #e0f2fe; color: #0369a1; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem;"><%= (c.name || 'C').charAt(0).toUpperCase() %></div>
                  <!-- FIN MODIFICACION -->
                <% } %>
                <h2 style="margin: 0; font-size: 1.05rem; color: #1f2937;"><%= c.name %> <%= c.apellido || '' %></h2>
              </div>
              <p><strong>Edad:</strong> <%= c.edad ? c.edad + ' años' : 'No especificada' %></p>
              <p><strong>Correo:</strong> <%= c.email || '—' %></p>
              <p><strong>Teléfono:</strong> <%= c.telefono || 'No especificado' %></p>
              <p><strong>Ciudad:</strong> <%= c.direccion || 'No especificado' %></p>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div style="background: white; border-radius: 16px; padding: 40px 20px; text-align: center; box-shadow: 0 4px 20px rgba(0,0,0,0.06);">
          <p style="color: #6b7280; font-weight: 600; margin: 0 0 8px 0;">No hay clientes registrados aún</p>
          <p style="color: #9ca3af; font-size: 0.9rem; margin: 0;">Cuando se registren clientes aparecerán aquí automáticamente.</p>
        </div>
      <% } %>
    </section>
  </main>
<!-- FIN MODIFICACION -->

   <%- include('../partials/footer'); %>
</body>
</html>
