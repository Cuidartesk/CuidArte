<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../partials/head'); %>
</head>
<body>

   <%- include('../partials/header'); %>

<!-- INICIO MODIFICACION: confirmar compra, portado de comprar_carrito.html de Django -->
  <section class="welcome-section" style="padding: 40px 20px;">
    <div class="container">
      <h1>Confirmar Compra</h1>
      <p>Revisa tu pedido y confirma tus datos</p>
    </div>
  </section>

  <main class="container" style="padding: 36px 20px; max-width: 760px;">
    <% if (error) { %>
      <div style="background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; padding: 12px 16px; border-radius: 10px; margin-bottom: 16px;"><%= error %></div>
    <% } %>

    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); padding: 22px; margin-bottom: 20px;">
      <h3 style="margin: 0 0 14px 0; font-size: 1.05rem; font-weight: 700; color: #1f2937;">Resumen del pedido</h3>
      <% items.forEach(function(item) { %>
        <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f3f4f6;">
          <span style="color: #374151;"><%= item.producto.name %> x<%= item.cantidad %></span>
          <span style="color: #1f2937; font-weight: 600;"><%= formatearPrecio(item.subtotal) %></span>
        </div>
      <% }); %>
      <div style="display: flex; justify-content: space-between; padding: 14px 0 0 0; font-weight: 800; font-size: 1.1rem; color: #1f2937;">
        <span>Total</span>
        <span><%= formatearPrecio(total) %></span>
      </div>
    </div>

    <div style="background: white; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); padding: 22px;">
      <h3 style="margin: 0 0 14px 0; font-size: 1.02rem; font-weight: 700; color: #1f2937;">Datos de env&iacute;o</h3>
      <p style="color: #9ca3af; font-size: 0.85rem; margin: 0 0 16px 0;">Nombre y correo vienen de tu cuenta. Puedes editar el tel&eacute;fono y la ciudad / direcci&oacute;n para este env&iacute;o.</p>

      <form method="POST" action="/comprar-carrito">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
          <div>
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Nombre</label>
            <input type="text" value="<%= usuario.name %> <%= usuario.apellido || '' %>" disabled style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; background: #f3f4f6; color: #6b7280;">
          </div>
          <div>
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Correo</label>
            <input type="text" value="<%= usuario.email %>" disabled style="width: 100%; padding: 10px 14px; border: 1px solid #e5e7eb; border-radius: 10px; background: #f3f4f6; color: #6b7280;">
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
          <div>
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Tel&eacute;fono</label>
            <input type="text" name="telefono" value="<%= telefonoVal || (usuario.telefono || '') %>" required maxlength="10" placeholder="10 d&iacute;gitos" style="width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 10px; background: white; color: #1f2937;">
            <p style="color: #9ca3af; font-size: 0.8rem; margin: 4px 0 0 0;">Debe tener exactamente 10 d&iacute;gitos</p>
          </div>
          <div>
            <label style="display: block; font-weight: 600; color: #374151; margin-bottom: 6px; font-size: 0.9rem;">Ciudad / Direcci&oacute;n</label>
            <input type="text" name="direccion" value="<%= direccionVal || (usuario.direccion || '') %>" required minlength="5" placeholder="Ciudad y direcci&oacute;n de env&iacute;o" style="width: 100%; padding: 10px 14px; border: 1px solid #d1d5db; border-radius: 10px; background: white; color: #1f2937;">
          </div>
        </div>

        <div style="margin-top: 18px;">
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <button type="submit" style="flex: 1; background: linear-gradient(135deg, #27BEF5, #6DD5FA); color: white; padding: 12px; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(39,190,245,0.25);">Confirmar compra</button>
            <a href="/carrito" style="background: #f3f4f6; color: #374151; padding: 12px 20px; border-radius: 10px; text-decoration: none; font-weight: 600; text-align: center;">Volver al carrito</a>
          </div>
        </div>
      </form>
    </div>
  </main>
<!-- FIN MODIFICACION -->

   <%- include('../partials/footer'); %>
</body>
</html>
