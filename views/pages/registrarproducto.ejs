<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../partials/head'); %>
</head>
<body>

   <%- include('../partials/header'); %>

  <section class="contacto-hero">
    <div class="container">
      <h1>Agregar producto</h1>
      <p>La imagen que subas se guarda directamente en la base de datos.</p>
    </div>
  </section>

  <section class="contacto-section">
    <div class="formulario-contacto" style="max-width: 640px; margin: 0 auto;">
      <h2>Datos del producto</h2>

      <!-- INICIO MODIFICACION: envio nativo + campo oculto para la imagen Base64 -->
      <form id="formProducto" method="POST" action="/api/v1/products">
      <!-- FIN MODIFICACION -->
        <div class="form-group">
          <label for="name">Nombre *</label>
          <input type="text" id="name" name="name" required>
        </div>

        <div class="form-group">
          <label for="description">Descripci&oacute;n *</label>
          <textarea id="description" name="description" rows="3" required></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="price">Precio (COP) *</label>
            <input type="number" id="price" name="price" min="0" required>
          </div>
          <div class="form-group">
            <label for="stock">Stock *</label>
            <input type="number" id="stock" name="stock" min="0" value="10" required>
          </div>
        </div>

        <div class="form-group">
          <label for="category">Categor&iacute;a</label>
          <select id="category" name="category">
            <option value="biomedicos">Biom&eacute;dicos</option>
            <option value="movilidad">Movilidad</option>
            <option value="cuidado personal">Cuidado personal</option>
          </select>
        </div>

        <div class="form-group">
          <label for="imagen">Imagen del producto</label>
          <input type="file" id="imagen" accept="image/*">
          <img id="preview" src="" alt="" style="display:none; max-width: 200px; margin-top: 10px; border-radius: 10px;">
          <!-- INICIO MODIFICACION: aqui JS deja la imagen ya convertida en texto -->
          <input type="hidden" name="imageData" id="imageData" value="">
          <!-- FIN MODIFICACION -->
        </div>

        <button type="submit" class="btn-enviar"><span>Guardar producto</span></button>
      </form>
    </div>
  </section>

   <%- include('../partials/footer'); %>

   <!-- Toda la logica de imagenes vive en este archivo aparte -->
   <script src="/js/imagenes_base64.js"></script>
</body>
</html>
