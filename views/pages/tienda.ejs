<!DOCTYPE html>
<html lang="es">
<head>
   <%- include('../partials/head'); %>
</head>
<body>

   <%- include('../partials/header'); %>

<!-- INICIO MODIFICACION: tienda portada de tienda.html de Django
     (categorias funcionales, boton de carrito y agregar al carrito) -->
  <!-- Hero -->
  <section class="tienda-hero">
    <div class="container">
      <h1>Tienda de Suministros M&eacute;dicos</h1>
      <p>Dispositivos biom&eacute;dicos, suministros y productos de cuidado para el bienestar integral.</p>
    </div>
  </section>

  <!-- Filtros por categoria -->
  <section class="tienda-filtros container">
    <% if (locals.mensaje) { %>
      <div style="width: 100%; margin-bottom: 20px;">
        <div style="background: <%= mensaje.tipo === 'error' ? '#fee2e2; color: #991b1b; border: 1px solid #fecaca' : '#ecfdf5; color: #065f46; border: 1px solid #a7f3d0' %>; padding: 15px 20px; border-radius: 12px; font-weight: 500; text-align: center;">
          <%= mensaje.texto %>
        </div>
      </div>
    <% } %>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <a href="/tienda" class="filtro-chip <%= !categoriaActual ? 'activo' : '' %>">Todos</a>
        <% categorias.forEach(function(cat) { const valor = cat[0], etiqueta = cat[1]; %>
          <a href="/tienda?categoria=<%= valor %>" class="filtro-chip <%= categoriaActual === valor ? 'activo' : '' %>"><%- etiqueta %></a>
        <% }); %>
      </div>
      <% if (locals.usuario) { %>
        <!-- Carrito con contador, igual que en Django -->
        <a href="/carrito" style="background: #27BEF5; color: white; padding: 10px 18px; border-radius: 10px; text-decoration: none; font-weight: 700; display: flex; align-items: center; gap: 8px; position: relative;">
          &#128722; Carrito <% if (carritoCount > 0) { %><span style="background: #ef4444; color: white; padding: 2px 8px; border-radius: 10px; font-size: 0.8rem;"><%= carritoCount %></span><% } %>
        </a>
      <% } %>
    </div>
  </section>

  <!-- Productos -->
  <section class="tienda-productos">
    <div class="container">
      <% if (productos.length > 0) { %>
        <div class="tienda-grid">
          <% productos.forEach(function(producto) { %>
            <div class="producto-card">
              <div class="producto-imagen">
                <% if (producto.imageData) { %>
                  <img src="<%= producto.imageData %>" alt="<%= producto.name %>">
                <% } else { %>
                  <div class="producto-imagen-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"></path>
                      <path d="M3 8l9 5 9-5"></path>
                    </svg>
                  </div>
                <% } %>
                <span class="producto-categoria"><%= etiquetaCategoria(producto.category) %></span>
              </div>

              <div class="producto-content">
                <h3><%= producto.name %></h3>
                <p><%= producto.description %></p>

                <div class="producto-footer" style="margin-top: 15px; display: flex; align-items: center; justify-content: space-between;">
                  <div class="producto-precio"><%= formatearPrecio(producto.price) %></div>
                  <span class="producto-stock <%= producto.stock === 0 ? 'agotado' : '' %>">
                    <% if (producto.stock === 0) { %>Agotado<% } else if (producto.stock <= 5) { %>&Uacute;ltimas <%= producto.stock %> unidades<% } else { %>Disponible<% } %>
                  </span>
                </div>

                <div style="margin-top: 15px;">
                  <% if (producto.stock > 0) { %>
                    <% if (locals.usuario) { %>
                      <form method="post" action="/agregar-carrito/<%= producto._id %>">
                        <button type="submit" style="display: block; width: 100%; padding: 12px; border-radius: 10px; font-weight: 700; background: linear-gradient(135deg, #27BEF5, #6DD5FA); color: white; border: none; cursor: pointer;">Agregar al carrito</button>
                      </form>
                    <% } else { %>
                      <a href="/ingresar?next=/tienda" style="display: block; text-align: center; text-decoration: none; padding: 12px; border-radius: 10px; font-weight: 700; background: linear-gradient(135deg, #27BEF5, #6DD5FA); color: white;">Agregar al carrito</a>
                    <% } %>
                  <% } else { %>
                    <button disabled style="background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; padding: 12px; border-radius: 10px; font-weight: 600; width: 100%; cursor: not-allowed;">Sin stock</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="construccion-box">
          <div class="construccion-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"></path>
              <path d="M3 8l9 5 9-5"></path>
            </svg>
          </div>
          <h2>No hay productos en esta categor&iacute;a</h2>
          <p>Pronto tendremos m&aacute;s suministros m&eacute;dicos disponibles para ti.</p>
          <a href="/tienda" class="btn-primary">Ver todos los productos</a>
        </div>
      <% } %>
    </div>
  </section>
<!-- FIN MODIFICACION -->

   <%- include('../partials/footer'); %>
</body>
</html>
